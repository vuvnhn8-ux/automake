# ============================================================
# AI Video Factory — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# ---- Application ----
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000
# Used by the Next.js dashboard to reach the API (client side)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/avf

# ---- Redis / Queue ----
REDIS_URL=redis://localhost:6379
# Queue driver: "bullmq" (requires Redis) or "memory" (dev only, in-process)
QUEUE_DRIVER=memory

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# 32-byte base64 key used to encrypt DB-backed secrets (provider API keys).
# Falls back to JWT_SECRET when empty (not recommended in production).
SECRET_ENCRYPTION_KEY=

# ---- AI text providers (at least one, or leave MOCK) ----
# AI_TEXT_PROVIDER: GEMINI | OPENAI | CLAUDE | MOCK
AI_TEXT_PROVIDER=MOCK
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_REQUEST_TIMEOUT_MS=90000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ---- Research ----
# RESEARCH_PROVIDER: MOCK | TAVILY | EXA (implemented as pluggable ResearchProvider)
RESEARCH_PROVIDER=MOCK
TAVILY_API_KEY=
EXA_API_KEY=

# ---- Image providers ----
# IMAGE_PROVIDER: OPENAI | MOCK
IMAGE_PROVIDER=MOCK
OPENAI_IMAGE_MODEL=gpt-image-1

# ---- Video (motion) providers ----
# VIDEO_PROVIDER: MOCK | VEO | KLING | RUNWAY | AGNES
VIDEO_PROVIDER=MOCK
GOOGLE_VEO_API_KEY=
RUNWAY_API_KEY=
RUNWAY_API_URL=https://api.dev.runwayml.com/v1
KLING_API_KEY=
AGNES_API_KEY=
AGNES_API_URL=https://apihub.agnes-ai.com/v1

# ---- Voice providers ----
# VOICE_PROVIDER: OPENAI | GOOGLE | ELEVENLABS | MOCK
VOICE_PROVIDER=MOCK
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
GOOGLE_TTS_VOICE=vi-VN-Standard-D
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---- Storage ----
# STORAGE_DRIVER: local | s3
STORAGE_DRIVER=local
STORAGE_ROOT=./data/storage
STORAGE_PUBLIC_URL=http://localhost:4000/files
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_FORCE_PATH_STYLE=true

# ---- Video rendering ----
# RENDER_DRIVER: ffmpeg | mock
RENDER_DRIVER=ffmpeg
FFMPEG_PATH=ffmpeg
FFMPEG_LOG_LEVEL=error

# ---- Facebook / Meta Graph API ----
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:4000/api/facebook/oauth/callback
FACEBOOK_GRAPH_VERSION=v22.0
# 32-byte base64 key used to encrypt stored page access tokens
FACEBOOK_TOKEN_ENCRYPTION_KEY=

# ---- Job / retry behaviour ----
MAX_RETRIES=3
JOB_TIMEOUT_MS=900000
RENDER_TIMEOUT_MS=600000
VOICE_TIMEOUT_MS=120000
IMAGE_TIMEOUT_MS=120000

# ---- Worker (hybrid deployment) ----
# Deployment role for this machine: "worker" | "api" | "web" | "scheduler"
# Informational; each process only ever runs what it is started to run.
ROLE=worker
# Stable per-machine identity; defaults to the OS hostname. Set explicitly when
# multiple workers share a hostname (e.g. containers).
WORKER_ID=
# Max concurrent jobs on this worker. FFmpeg rendering is CPU/RAM/disk heavy —
# keep at 1 for sequential processing; raise only with headroom.
WORKER_CONCURRENCY=1
# Root for render/publish temporary files. Cleared after every job.
# Defaults to <os-tmpdir>/ai-video-worker (e.g. /tmp/ai-video-worker on Linux,
# %TEMP%\ai-video-worker on Windows).
WORKER_TEMP_DIR=
# How often this worker writes its heartbeat (ms). Shown in the Workers page.
WORKER_HEARTBEAT_INTERVAL_MS=15000
# Arm active schedules at boot (scheduler role). Idempotent via stable jobIds;
# disable on home workers if the VPS worker is the designated scheduler.
WORKER_ARM_SCHEDULES=true

# ---- Defaults ----
DEFAULT_LANGUAGE=vi-VN
DEFAULT_TEMPLATE=DEFAULT_REELS
DEFAULT_VIDEO_RESOLUTION=1080x1920
IMAGE_SIZE=1080x1920
TTS_VOICE=
DEFAULT_FPS=30
